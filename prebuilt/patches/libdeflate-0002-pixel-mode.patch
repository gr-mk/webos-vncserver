 LIBDEFLATEAPI size_t
@@ -4120,7 +4258,18 @@ libdeflate_deflate_compress_sync(struct libdeflate_compressor *c,
 				 const void *in, size_t in_nbytes,
 				 void *out, size_t out_nbytes_avail)
 {
-	return deflate_compress(c, in, in_nbytes, out, out_nbytes_avail, true);
+	return deflate_compress(c, in, in_nbytes, out, out_nbytes_avail, true,
+				0);
+}
+
+LIBDEFLATEAPI size_t
+libdeflate_deflate_compress_sync_pixels(struct libdeflate_compressor *c,
+					const void *in, size_t in_nbytes,
+					void *out, size_t out_nbytes_avail,
+					size_t stride)
+{
+	return deflate_compress(c, in, in_nbytes, out, out_nbytes_avail, true,
+				stride);
 }
 
