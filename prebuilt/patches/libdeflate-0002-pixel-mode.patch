 	/* Return 0 if the output buffer is too small. */
 	if (os.overflow)
@@ -4112,7 +4249,8 @@ libdeflate_deflate_compress(struct libdeflate_compressor *c,
 			    const void *in, size_t in_nbytes,
 			    void *out, size_t out_nbytes_avail)
 {
-	return deflate_compress(c, in, in_nbytes, out, out_nbytes_avail, false);
+	return deflate_compress(c, in, in_nbytes, out, out_nbytes_avail, false,
