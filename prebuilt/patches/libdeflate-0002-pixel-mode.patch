+/*
+ * For deflate_compress_pixels(): log2 of the number of entries in the table of
+ * recent pixel positions.  A small table compresses slightly worse, but stays
+ * in L1 cache - which matters most when cores are shared with other work (on a
+ * TV streaming 4K video, 2^13 entries were ~35% faster than 2^15).
+ */
+#define PIXEL_HASH_ORDER	13
+
 /*
