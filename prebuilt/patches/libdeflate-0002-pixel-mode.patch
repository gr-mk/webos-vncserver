+/*
+ * This is the "fastest" DEFLATE compressor for 32-bit pixels, in rows of
+ * 'stride' bytes.  Only whole pixels are matched - against the previous pixel,
+ * the pixel above, and the most recent pixel with the same hash.  This is
+ * faster than looking for matches at every byte, and compresses images about
+ * as well.
+ */
+static void
+deflate_compress_pixels(struct libdeflate_compressor * restrict c,
+			const u8 *in, size_t in_nbytes,
+			struct deflate_output_bitstream *os, size_t stride)
+{
+	const u8 *in_next = in;
+	const u8 *in_end = in_next + in_nbytes;
+	u32 * const pixel_tab = c->p.f.pixel_tab;
+
+	if (stride > DEFLATE_MAX_MATCH_OFFSET)
+		stride = 0;
+
+	do {
+		/* Starting a new DEFLATE block */
+
+		const u8 * const in_block_begin = in_next;
+		const u8 * const in_max_block_end = choose_max_block_end(
+				in_next, in_end, FAST_SOFT_MAX_BLOCK_LENGTH);
+		struct deflate_sequence *seq = c->p.f.sequences;
+
+		deflate_begin_sequences(c, seq);
+
+		do {
+			u32 pos = in_next - in;
+			size_t remaining = in_end - in_next;
+			u32 max_len;
+			u32 length = 0;
+			u32 offset = 0;
+			u32 pixel;
+			u32 hash;
+			u32 cand;
+
+			if (unlikely(remaining < 8)) {
+				/* Not worth matching the last pixel */
+				do {
+					deflate_choose_literal(c, *in_next++,
+							       false, seq);
+				} while (in_next != in_end);
+				break;
+			}
+
+			max_len = MIN(remaining, DEFLATE_MAX_MATCH_LEN) & ~3U;
+			pixel = load_u32_unaligned(in_next);
+
+			if (pos >= 4 &&
+			    pixel == load_u32_unaligned(in_next - 4)) {
+				length = lz_extend(in_next, in_next - 4, 4,
+						   max_len);
+				offset = 4;
+			}
+
+			if (stride && pos >= stride && length < max_len &&
+			    pixel == load_u32_unaligned(in_next - stride)) {
+				u32 len = lz_extend(in_next, in_next - stride,
+						    4, max_len);
+
+				if (len > length) {
+					length = len;
+					offset = stride;
+				}
+			}
+
+			/*
+			 * Entries left by previous calls are harmless, since
+			 * matches are verified.
+			 */
+			hash = lz_hash(pixel, PIXEL_HASH_ORDER);
+			cand = pixel_tab[hash];
+			pixel_tab[hash] = pos;
+			if (length < max_len && cand < pos &&
+			    pos - cand <= DEFLATE_MAX_MATCH_OFFSET &&
+			    pos - cand != offset &&
+			    pixel == load_u32_unaligned(in + cand)) {
+				u32 len = lz_extend(in_next, in + cand, 4,
+						    max_len);
+
+				if (len > length) {
+					length = len;
+					offset = pos - cand;
+				}
+			}
+
+			if (length) {
+				/* Match found - of whole pixels */
+				length &= ~3U;
+				deflate_choose_match(c, length, offset, false,
+						     &seq);
+				in_next += length;
+			} else {
+				/* No match found */
+				deflate_choose_literal(c, in_next[0], false,
+						       seq);
+				deflate_choose_literal(c, in_next[1], false,
+						       seq);
+				deflate_choose_literal(c, in_next[2], false,
+						       seq);
+				deflate_choose_literal(c, in_next[3], false,
+						       seq);
+				in_next += 4;
+			}
+
+			/* Check if it's time to output another block. */
+		} while (in_next < in_max_block_end &&
+			 seq < &c->p.f.sequences[FAST_SEQ_STORE_LENGTH]);
+
+		deflate_finish_block(c, os, in_block_begin,
+				     in_next - in_block_begin,
+				     c->p.f.sequences, in_next == in_end);
+	} while (in_next != in_end && !os->overflow);
+}
