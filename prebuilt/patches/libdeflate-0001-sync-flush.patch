diff --git a/libdeflate.h b/libdeflate.h
index 1821acd..199089d 100644
--- a/libdeflate.h
+++ b/libdeflate.h
@@ -115,6 +115,24 @@ LIBDEFLATEAPI size_t
 libdeflate_deflate_compress_bound(struct libdeflate_compressor *compressor,
 				  size_t in_nbytes);
 
+/*
+ * Like libdeflate_deflate_compress(), but instead of a complete DEFLATE stream,
+ * the output is a "sync flushed" piece of one: none of its blocks is marked
+ * final, and it ends with an empty uncompressed block, so it ends on a byte
+ * boundary with the bytes 00 00 FF FF -- like the output of zlib's deflate()
+ * with Z_SYNC_FLUSH.  Thus the outputs of multiple calls can be concatenated
+ * into one stream, which a single zlib inflate stream can decompress piece by
+ * piece.  Each call compresses its input independently of previous calls.
+ * Nothing here ends the stream; for that, append a final block yourself.
+ *
+ * The output size is at most 5 bytes more than
+ * libdeflate_deflate_compress_bound(compressor, in_nbytes).
+ */
+LIBDEFLATEAPI size_t
+libdeflate_deflate_compress_sync(struct libdeflate_compressor *compressor,
+				 const void *in, size_t in_nbytes,
+				 void *out, size_t out_nbytes_avail);
+
 /*
  * Like libdeflate_deflate_compress(), but uses the zlib wrapper format instead
  * of raw DEFLATE.
