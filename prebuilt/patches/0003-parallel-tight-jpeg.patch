+/*
+ * Parallel JPEG compression. JPEG subrectangles don't depend on any encoder
+ * state (unlike the other subencodings, which use persistent zlib streams),
+ * so while a large rectangle is being encoded they are queued and compressed
+ * by worker threads, and sent as soon as they are done. Rectangles of an
+ * update can be sent in any order.
+ */
+#define TIGHT_JPEG_THREADS 3
+/* Rectangles smaller than this are compressed by the client thread itself */
+#define TIGHT_JPEG_MIN_PARALLEL_SIZE (2 * 65536)
+
+typedef struct {
+    int x, y, w, h;
+    int quality, subsamp;
+    unsigned char *data;
+    unsigned long size;
+    /* 0 - pending, 1 - compressed, -1 - failed */
+    int state;
+} rfbTightJpegRect;
+
+typedef struct {
+    const unsigned char *fb;
+    int pitch, ps, flags;
+    rfbTightJpegRect *rects;
+    int nRects, maxRects;
+    int nextRect;   /* next rectangle to be compressed by a worker */
+    int nextSend;   /* next rectangle to be sent by the client thread */
+    rfbBool finished;
+    rfbBool failed;
+    pthread_mutex_t mutex;
+    pthread_cond_t cond;
+    pthread_t threads[TIGHT_JPEG_THREADS];
+    int nThreads;
+} rfbTightJpegBatch;
+
+/* Batch of the rectangle currently being encoded by this thread, if any */
+static TLS rfbTightJpegBatch *jpegBatch = NULL;
